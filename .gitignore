# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# working backups taken while making changes
*.bak
*.bak[0-9]

# The offline demo file seeds its register with plain-text passwords, including a real
# address (mustaq@toprockinteriors.com). This repository is public, so it is held back.
# Scrub those seed accounts before adding it.
/preview/
tsconfig.tsbuildinfo
