# Payment Request app — copy to env/payment.env (git-ignored) and fill in.

# Shared with Material (env/material.env PAYMENT_APP_TOKEN). 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_TOKEN=

# Public address of the Payment app (links in its emails).
APP_URL=https://paymentrequest.cmis.ac.in

# Mail through Microsoft Graph (see lib/mail.ts). Leave blank to keep mail off.
MAIL_CLIENT_EMAIL=
MAIL_PRIVATE_KEY=
MAIL_FROM=
MAIL_FROM_NAME=CMG Payment Request
MAIL_SEND_AS=
MAIL_REPLY_TO=
MAIL_REDIRECT_TO=
RELAY_URL=
RELAY_TOKEN=
