# Material Management — copy to env/material.env (git-ignored) and fill in.
NODE_ENV=production
LOG_LEVEL=info

# Public address of Material (links in its emails). Note the /material.
APP_URL=https://paymentrequest.cmis.ac.in/material
WEB_ORIGIN=https://paymentrequest.cmis.ac.in

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Sign-on with the Payment app: the same value as INTEGRATION_TOKEN in env/payment.env.
PAYMENT_APP_TOKEN=

# File storage (Cloudinary). Blank = stored on the API's disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chandramari-material

# Email: smtp | brevo | resend
MAIL_PROVIDER=smtp
MAIL_FROM=Chandramari <noreply@example.com>
MAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

SEED_ALLOWED=false
BULL_BOARD_ENABLED=true
