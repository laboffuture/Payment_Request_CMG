# ---------------------------------------------------------------------------
# Chandramari Material Management — copy to .env and fill in before `docker compose up`
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080

# --- database -------------------------------------------------------------
# Single-node replica set `rs0` so multi-document transactions work.
MONGO_URI=mongodb://mongo:27017/chandramari_material?replicaSet=rs0&directConnection=true

# --- cache / queue --------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=

# --- file storage (Cloudinary) -------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chandramari-material

# --- email ----------------------------------------------------------------
# MAIL_PROVIDER: smtp | brevo | resend
MAIL_PROVIDER=smtp
MAIL_FROM=Chandramari <noreply@example.com>
MAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- payment app (external masters, §10) ---------------------------------
# Leave blank to use the stub adapter that returns empty arrays.
PAYMENT_APP_BASE_URL=
PAYMENT_APP_TOKEN=

# --- misc -----------------------------------------------------------------
LOG_LEVEL=info
PORT=4000
SEED_ALLOWED=true
BULL_BOARD_ENABLED=true
